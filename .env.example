# KLU Commons Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key for private ERP session storage.
SUPABASE_SECRET_KEY=
# Base64-encoded 32 random bytes. Generate with: openssl rand -base64 32
ERP_SESSION_ENCRYPTION_KEY=
# Comma-separated ERP registration numbers permitted to open /admin.
ADMIN_REGISTRATION_NUMBERS=

# Authentication & Campus Restrictions
# Restrict registration to KL University student domain
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=kluniversity.in

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Limits (in bytes, e.g. 52428800 = 50MB)
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=52428800

# Cloudflare R2 Object Storage Configuration
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=klu-vss-files
# Optional: If you enable public bucket access or custom domain in Cloudflare
R2_PUBLIC_DOMAIN=
